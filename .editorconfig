# .editorconfig · reglas comunes para cualquier editor (VS Code lo respeta con su extensión)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
