# =============================================================================
# .env.example · plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo como .env (que Git ignora) y rellena los valores reales:
#     Copy-Item .env.example .env
# NUNCA pongas valores reales en este archivo: se sube al repositorio.
# Se irán agregando variables en cada fase.
# =============================================================================

# Fase 2 · base de datos
DATABASE_URL=

# Fase 3 · APIs externas
LASTFM_API_KEY=

# Entorno: development | production
MELOMAP_ENV=development
